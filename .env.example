# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=almuerzo
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=almuerzo

# Puerto de PostgreSQL expuesto al host (para conectarse con un cliente SQL)
DB_PORT=3254

# --- Backend ---
# Puerto del backend expuesto al host
BACKEND_PORT=3004
JWT_SECRET=cambia_este_secret_jwt

# Credenciales iniciales del administrador
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# --- Delivery ---
# Monto total de delivery repartido entre los pedidos del dia (S/)
DELIVERY_TOTAL=5.00

# --- Frontend ---
FRONTEND_PORT=8080

# --- CORS ---
# Origenes permitidos (separados por coma) desde los cuales el navegador
# puede llamar al backend. Si lo dejas vacio se usan los puertos por defecto
# del frontend (FRONTEND_PORT) y del dev server de Vite (5173).
CORS_ORIGINS=http://localhost:8080

# --- Zona horaria (fecha "hoy" para los cobros del dia) ---
TZ=America/Lima
